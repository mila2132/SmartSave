<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SmartSave"
			 xmlns:converters="clr-namespace:SmartSave.Converters;assembly=SmartSave"
             x:Class="SmartSave.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
			<converters:HourFormatConverter x:Key="HourFormatConverter"/>
			<converters:PriceFormatConverter x:Key="PriceFormatConverter"/>
		</ResourceDictionary>
    </Application.Resources>
</Application>
