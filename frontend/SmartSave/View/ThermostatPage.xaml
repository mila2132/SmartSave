<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:viewModel="clr-namespace:SmartSave.ViewModel"
			 x:DataType="viewModel:ThermostatViewModel"
			 Title="{Binding Title}" 
			 BackgroundColor="#F5F5F6"
             x:Class="SmartSave.View.ThermostatPage"
			 Shell.NavBarIsVisible="true">
	
	<StackLayout Orientation="Vertical" Margin="10">
		<Grid VerticalOptions="Start"
			  ColumnDefinitions="25*,75*"
			  ColumnSpacing="15"
			  RowDefinitions="50*,50*"
			  Padding="5">
			<Button Grid.Column="0"
					Grid.RowSpan="2"
                    Style="{StaticResource CircleButtonStyle}" Scale="1.3"
					Command="{Binding TurnOnOffCommand}">
				<Button.Triggers>
					<DataTrigger TargetType="Button" Binding="{Binding IsOff}" Value="True">
						<Setter Property="Text" Value="OFF"/>
						<Setter Property="BackgroundColor" Value="Red"/>
					</DataTrigger>
					<DataTrigger TargetType="Button" Binding="{Binding IsOff}" Value="False">
						<Setter Property="Text" Value="ON"/>
						<Setter Property="BackgroundColor" Value="Green"/>
					</DataTrigger>
				</Button.Triggers>
			</Button>

			<Button Text="Manual"
                    Grid.Column="1"
					Grid.Row="0"
                    Style="{StaticResource ModeButtonStyle}"
					Command="{Binding ActiveManualModeCommand}">
				<Button.Triggers>
					<DataTrigger TargetType="Button" Binding="{Binding IsAutomaticMode}" Value="False">
						<Setter Property="BackgroundColor" Value="#FF699198"/>
					</DataTrigger>
					<DataTrigger TargetType="Button" Binding="{Binding IsAutomaticMode}" Value="True">
						<Setter Property="BackgroundColor" Value="#84BDC7"/>
					</DataTrigger>
					<DataTrigger TargetType="Button" Binding="{Binding IsOff}" Value="True">
						<Setter Property="IsEnabled" Value="False"/>
					</DataTrigger>
					<Trigger TargetType="Button" Property="IsPressed" Value="True">
						<Setter Property="BackgroundColor" Value="#FF699198"/>
					</Trigger>
				</Button.Triggers>
			</Button>
			<Button Text="Automatico"
                    Grid.Column="1"
					Grid.Row="1"
                    Style="{StaticResource ModeButtonStyle}"
					Command="{Binding OpenAutomaticModeCommand}">
				<Button.Triggers>
					<DataTrigger TargetType="Button" Binding="{Binding IsAutomaticMode}" Value="True">
						<Setter Property="BackgroundColor" Value="#FF699198"/>
					</DataTrigger>
					<DataTrigger TargetType="Button" Binding="{Binding IsAutomaticMode}" Value="False">
						<Setter Property="BackgroundColor" Value="#84BDC7"/>
					</DataTrigger>
					<DataTrigger TargetType="Button" Binding="{Binding IsOff}" Value="True">
						<Setter Property="IsEnabled" Value="False"/>
					</DataTrigger>
					<Trigger TargetType="Button" Property="IsPressed" Value="True">
						<Setter Property="BackgroundColor" Value="#FF699198"/>
					</Trigger>
				</Button.Triggers>
			</Button>
		</Grid>

		<!-- Indicador de temperatura actual -->
		<Frame CornerRadius="100"
               HorizontalOptions="Center"
               VerticalOptions="CenterAndExpand" HeightRequest="100" WidthRequest="100" Scale="3.5" HasShadow="True" Background="#444444">
			<Frame.Triggers>
				<DataTrigger TargetType="Frame" Binding="{Binding IsOff}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
				</DataTrigger>
			</Frame.Triggers>
			<Frame WidthRequest="100" HeightRequest="100" CornerRadius="100" Scale="0.885" Background="#6CB9C7" HasShadow="True">
				<Grid RowDefinitions="0.8*,0.2*">
					<Frame WidthRequest="50" HeightRequest="30" BackgroundColor="#FFFFFF">
						<Label Text="{Binding TemperatureMqtt}"
							   FontSize="Small"
							   TextColor="#000000"
						   	   VerticalTextAlignment="Start" WidthRequest="44" HeightRequest="33"/>
					</Frame>
					<Label Text="Temperatura actual"
						   FontSize="Micro"
						   Margin="-20"
						   VerticalTextAlignment="Start" TextColor="#FFFFFF" 
						   Grid.Row="1" Scale="0.5" WidthRequest="100" HorizontalOptions="Center" HorizontalTextAlignment="Center"  />
				</Grid>
			</Frame>
			
		</Frame>

		<!-- Controles de Temperatura -->
		<Frame WidthRequest="345" Padding="-3" HeightRequest="220" 
			   BackgroundColor="LightGray" BorderColor="Transparent" HasShadow="True" VerticalOptions="End" HorizontalOptions="CenterAndExpand">
			<Frame.Triggers>
				<DataTrigger TargetType="Frame" Binding="{Binding IsOff}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
				</DataTrigger>
			</Frame.Triggers>
			<Grid ColumnDefinitions="50*,50*"
				  RowDefinitions="10*,60*,30*"
				  Padding="15"
				  ColumnSpacing="55">

				<Label Text="{Binding ModeText}"
					   Grid.Column="0"
					   Grid.Row="0"
					   HorizontalOptions="CenterAndExpand" TextColor="#090202" VerticalTextAlignment="Center" VerticalOptions="Start"/>
				<Switch Grid.Column="0"
						Grid.Row="1"
						HorizontalOptions="CenterAndExpand"
						Scale="2" HeightRequest="100" VerticalOptions="Center"
						OnColor="#84BDC7" ThumbColor="#444444" 
						IsToggled="{Binding IsHeatMode}"/>
			
				<Label Text="Temperatura °C"
					   Grid.Column="1"
					   Grid.Row="0"
					   HorizontalOptions="Start" TextColor="#000000" VerticalTextAlignment="Center" VerticalOptions="Start" InputTransparent="True" HorizontalTextAlignment="Start"/>
				<Frame Grid.Column="1"
					   Grid.Row="1"
					   CornerRadius="20" WidthRequest="110" HeightRequest="70" HorizontalOptions="StartAndExpand">
					<Entry Text="{Binding Temperature}"
						   FontSize="25"
						   Keyboard="Numeric" WidthRequest="45" HeightRequest="50" TextColor="#000000"/>
				</Frame>

				<Button Text="Enviar"
						Grid.ColumnSpan="2"
						Grid.Row="2" WidthRequest="100" HorizontalOptions="Center" HeightRequest="45"
						BackgroundColor="#84BDC7" BorderColor="Black" BorderWidth="1"
						Command="{Binding SendDataCommand}">
					<Button.Triggers>
						<Trigger TargetType="Button" Property="IsPressed" Value="True">
							<Setter Property="BackgroundColor" Value="#FF699198"/>
						</Trigger>
					</Button.Triggers>
				</Button>
			</Grid>
		</Frame>
		
	</StackLayout>
</ContentPage>