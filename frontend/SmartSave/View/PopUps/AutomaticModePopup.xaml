<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			   xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
			   xmlns:viewmodelpopups="clr-namespace:SmartSave.ViewModel.PopUps"
			   x:DataType="viewmodelpopups:AutomaticModeViewModel"
			   x:Class="SmartSave.View.PopUps.AutomaticModePopup"
			   x:Name="automaticModePopUp"
			   Size="350,210">
	<StackLayout Padding="20" Spacing="15" BackgroundColor="LightGray">
		<Label Text="Introduce una temperatura y modo para cuando el coste sea aceptable" 
			   WidthRequest="300" VerticalTextAlignment="Center" FontSize="Subtitle" TextColor="#000000" HorizontalTextAlignment="Center" HorizontalOptions="Center" />

		<Grid ColumnDefinitions="0.5*,0.5*"
			  ColumnSpacing="-70">
			<StackLayout Orientation="Horizontal" HorizontalOptions="Center" Grid.Column="0" VerticalOptions="Center" >
				<Entry WidthRequest="50" Text="{Binding Temperature}" Keyboard="Numeric" TextColor="#000000" />
				<Label Text="°C" VerticalOptions="Center" TextColor="#000000" />
			</StackLayout>

			<StackLayout Orientation="Horizontal" HorizontalOptions="Center" Grid.Column="1">
				<Button Text="Heat" Margin="5" BackgroundColor="#D7DBDE" Command="{Binding ToggleHeatCommand}">
					<Button.Triggers>
						<DataTrigger TargetType="Button" Binding="{Binding IsHeatPressed}" Value="True">
							<Setter Property="BackgroundColor" Value="#B0B5B8"/>
						</DataTrigger>
						<DataTrigger TargetType="Button" Binding="{Binding IsHeatPressed}" Value="False">
							<Setter Property="BackgroundColor" Value="#D7DBDE"/>
						</DataTrigger>
					</Button.Triggers>
				</Button>
				<Button Text="Cool" Margin="5" BackgroundColor="#D7DBDE" Command="{Binding ToggleCoolCommand}">
					<Button.Triggers>
						<DataTrigger TargetType="Button" Binding="{Binding IsHeatPressed}" Value="False">
							<Setter Property="BackgroundColor" Value="#B0B5B8"/>
						</DataTrigger>
						<DataTrigger TargetType="Button" Binding="{Binding IsHeatPressed}" Value="True">
							<Setter Property="BackgroundColor" Value="#D7DBDE"/>
						</DataTrigger>
					</Button.Triggers>
				</Button>
			</StackLayout>
		</Grid>

		<Button Text="Enviar" Command="{Binding SendCommand}" 
				CommandParameter="{Binding Source={x:Reference automaticModePopUp}}"
				WidthRequest="90" HeightRequest="42" BackgroundColor="#8EB6BE" >
			<Button.Triggers>
				<Trigger TargetType="Button" Property="IsPressed" Value="True">
					<Setter Property="BackgroundColor" Value="#FF699198"/>
				</Trigger>
			</Button.Triggers>
		</Button>
	</StackLayout>
</toolkit:Popup>
