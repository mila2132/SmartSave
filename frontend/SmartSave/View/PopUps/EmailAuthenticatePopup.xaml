<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			   xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
			   xmlns:viewmodelpopups="clr-namespace:SmartSave.ViewModel.PopUps"
			   x:DataType="viewmodelpopups:EmailAuthenticateViewModel"
			   x:Class="SmartSave.View.PopUps.EmailAuthenticatePopup"
			   Size="350,180"
			   x:Name="emailPopUp">
	<StackLayout  Padding="10" BackgroundColor="LightGray">
		<Entry Text="{Binding Email}" Placeholder="Enter your email" Margin="20" TextColor="Black"/>
		<Button Text="Enviar" Command="{Binding AuthenticateCommand}"
				CommandParameter="{Binding Source={x:Reference emailPopUp}}"
				WidthRequest="90" HeightRequest="42" BackgroundColor="#8EB6BE">
			<Button.Triggers>
				<Trigger TargetType="Button" Property="IsPressed" Value="True">
					<Setter Property="BackgroundColor" Value="#FF699198"/>
				</Trigger>
			</Button.Triggers>
		</Button>
	</StackLayout>
</toolkit:Popup>
